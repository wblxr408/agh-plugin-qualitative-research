{
  "name": "@wblxr408/qualitative-research",
  "version": "0.5.2",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.10"
  },
  "exports": "./index.mjs",
  "files": [
    "*.mjs",
    "report.css",
    "client",
    "fixtures",
    "README.md",
    "agh.market.json",
    "LICENSE",
    "LICENSE.LLMCode",
    "LICENSE.d3-hierarchy",
    "LICENSE.Fuse",
    "NOTICE"
  ],
  "agnes": {
    "plugins": [
      {
        "export": "main",
        "apiRange": "^5.0.0",
        "id": "ext:@wblxr408/qualitative-research/main",
        "inject": [
          "tools",
          "providers",
          "skills"
        ],
        "capabilities": {
          "model": true,
          "ui": true,
          "filesystem": {
            "read": [
              "**/*.txt",
              "**/*.md"
            ],
            "write": [
              "fde-output/qualitative-research/**"
            ]
          }
        }
      }
    ],
    "clientDescriptors": [
      {
        "rowId": "ext:@wblxr408/qualitative-research/main",
        "path": "./client/agnes.client.json"
      }
    ],
    "hostProvidedExternals": {
      "@agnes/plugin-runtime": "0.0.0",
      "@agnes/extension-api": "^5.0.0",
      "@sinclair/typebox": "~0.34.0"
    },
    "bundles": {
      "qualitative-research": {
        "profile": {
          "providers": {
            "loop": {
              "provider": "fde.qualitative-research",
              "version": "5.0.0"
            }
          }
        },
        "presets": {
          "qualitative-research": {
            "name": "qualitative-research",
            "extends": "standard",
            "providers": {
              "tool-policy": {
                "provider": "fde.qualitative-research"
              }
            }
          }
        },
        "launch": {
          "title": {
            "en": "Qualitative research",
            "zh-CN": "访谈主题分析"
          },
          "description": {
            "en": "Code interview excerpts and present candidate themes with source quotes.",
            "zh-CN": "分批编码访谈材料，生成带原文引文的候选主题。"
          },
          "preset": "qualitative-research",
          "prompt": {
            "text": {
              "en": "demo",
              "zh-CN": "演示"
            },
            "mode": "draft"
          }
        }
      }
    },
    "metadata": {
      "displayName": "Qualitative research",
      "summary": "Code interview excerpts and present candidate themes with source quotes.",
      "description": "Code interview excerpts and present candidate themes with source quotes.",
      "locales": {
        "zh-CN": {
          "displayName": "访谈主题分析",
          "summary": "分批编码访谈材料，生成带原文引文的候选主题。",
          "description": "分批编码访谈材料，生成带原文引文的候选主题。"
        }
      }
    },
    "provides": [
      "bundle",
      "loop",
      "tool",
      "ui"
    ]
  }
}
